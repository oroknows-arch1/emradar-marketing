{
  "version": "1.0",
  "architecture": "agentic_graph_with_persistent_feedback_loop",
  "source_of_truth": "plugged-in product contract",
  "nodes": [
    {
      "id": "ingest",
      "worker": "source",
      "output": "formation",
      "inputs": [
        "registered_product",
        "signal_id",
        "release_review"
      ],
      "outputs": [
        "formation"
      ],
      "authority": "bounded_transformation",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "signal_extraction",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "campaign",
      "worker": "campaign",
      "output": "campaign_hypotheses",
      "inputs": [
        "selected_signal",
        "campaign_id"
      ],
      "outputs": [
        "campaign_hypotheses"
      ],
      "authority": "bounded_transformation",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "relevance",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "scout",
      "worker": "scout",
      "output": "candidate_destinations",
      "inputs": [
        "product.destinations",
        "pending_publication_state"
      ],
      "outputs": [
        "candidate_destinations"
      ],
      "authority": "bounded_transformation",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "baseline",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "baseline",
      "worker": "destination_baseline",
      "rule": "retrieve only directly relevant material needed to establish what destination already knows",
      "output": "conversation_baseline",
      "inputs": [
        "candidate_destinations",
        "baseline_expiry"
      ],
      "outputs": [
        "conversation_baseline"
      ],
      "authority": "bounded_transformation",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "delta",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "delta",
      "worker": "emradar_delta",
      "input": [
        "formation",
        "conversation_baseline"
      ],
      "output": "novel_contribution",
      "inputs": [
        "source_revision",
        "evidence_ids",
        "destination_delta"
      ],
      "outputs": [
        "novel_contribution"
      ],
      "authority": "bounded_transformation",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "novelty_gate",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "novelty_gate",
      "worker": "gate",
      "hard": true,
      "pass": "meaningful_delta",
      "fail": "retire_or_reroute",
      "inputs": [
        "meaningful_delta_candidates"
      ],
      "outputs": [
        "novelty_gate_result"
      ],
      "authority": "verify_only",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "route",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "route",
      "worker": "bounded_route_decision",
      "output": "native_insertion_method",
      "inputs": [
        "eligible_destinations",
        "learning.routes",
        "learning.platforms"
      ],
      "outputs": [
        "native_insertion_method"
      ],
      "authority": "bounded_transformation",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "editorial_intelligence",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "editorial_intelligence",
      "worker": "editorial_intelligence",
      "input": [
        "formation",
        "novel_contribution",
        "native_insertion_method"
      ],
      "rule": "preserve evidence and uncertainty while adding publication-grade factual discipline, consequence mapping, market relevance, emerging-market depth and digital clarity",
      "output": "editorial_master_copy",
      "inputs": [
        "approved_copy",
        "product_copy_profile"
      ],
      "outputs": [
        "editorial_master_copy"
      ],
      "authority": "bounded_transformation",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "editorial_quality_gate",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "editorial_quality_gate",
      "worker": "gate",
      "hard": true,
      "checks": [
        "factual_precision",
        "signal_state_preserved",
        "uncertainty_preserved",
        "meaningful_delta_visible",
        "consequence_clear",
        "no_generic_finance_hype",
        "destination_appropriate"
      ],
      "fail": "repair_or_retire",
      "inputs": [
        "source_copy",
        "editorial_review",
        "uncertainty_state"
      ],
      "outputs": [
        "editorial_quality_gate_result"
      ],
      "authority": "verify_only",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "variant_factory",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "adapt",
      "worker": "adapter",
      "output": "destination_native_asset",
      "input": [
        "editorial_master_copy",
        "native_insertion_method"
      ],
      "inputs": [
        "format_asset",
        "platform_adapter"
      ],
      "outputs": [
        "destination_native_asset"
      ],
      "authority": "bounded_transformation",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "evidence_gate",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "permission_gate",
      "worker": "gate",
      "hard": true,
      "checks": [
        "evidence",
        "identity",
        "permission",
        "risk"
      ],
      "inputs": [
        "revision_permission",
        "account_auth",
        "budget_bounds"
      ],
      "outputs": [
        "permission_gate_result"
      ],
      "authority": "verify_only",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "publication_review",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "publication_review",
      "worker": "owner_publication_review",
      "hard": true,
      "inputs": [
        "gated_asset",
        "destination",
        "product_truth_hash",
        "source_revision",
        "current_permission",
        "owner_decision"
      ],
      "outputs": [
        "review_proposal_or_exact_approval"
      ],
      "authority": "owner_approval_only_for_external_publication",
      "failure_state": "AWAITING_REVIEW_OR_BLOCKED",
      "handoff": [
        "execute",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "human_required_for_external_publication"
    },
    {
      "id": "execute",
      "worker": "executor",
      "output": "external_action",
      "inputs": [
        "gated_asset",
        "receipt_history",
        "cost_ledger",
        "publication_hold"
      ],
      "outputs": [
        "external_action"
      ],
      "authority": "authorized_external_action",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "receipt",
        "receipt",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "receipt",
      "worker": "deterministic_recorder",
      "hard": true,
      "output": "execution_receipt",
      "inputs": [
        "execution_or_blocked_state",
        "lineage"
      ],
      "outputs": [
        "execution_receipt"
      ],
      "authority": "bounded_transformation",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "observe"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "observe",
      "worker": "observer",
      "output": "measured_result_or_UNKNOWN",
      "inputs": [
        "receipt",
        "platform_capabilities",
        "metrics_budget"
      ],
      "outputs": [
        "measured_result_or_UNKNOWN"
      ],
      "authority": "bounded_transformation",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "normalize"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "learn",
      "worker": "learning",
      "output": "route_learning",
      "inputs": [
        "normalized_outcome",
        "processed_observation_ids",
        "route_state"
      ],
      "outputs": [
        "route_learning"
      ],
      "authority": "route_learning_only",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "distribution_map"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "distribution_map",
      "worker": "state",
      "persistent": true,
      "loop_to": [
        "scout",
        "route",
        "campaign"
      ],
      "inputs": [
        "bounded_learning_update",
        "product_truth_hash"
      ],
      "outputs": [
        "distribution_map_result"
      ],
      "authority": "route_learning_only",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "signal_extraction",
      "worker": "signal_extractor",
      "inputs": [
        "product.signals"
      ],
      "outputs": [
        "signal_extraction_result"
      ],
      "authority": "bounded_transformation",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "signal_library",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "signal_library",
      "worker": "persistent_signal_library",
      "inputs": [
        "source_signals",
        "truth_hash"
      ],
      "outputs": [
        "signal_library_result"
      ],
      "authority": "bounded_transformation",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "priority",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "priority",
      "worker": "bounded_signal_priority",
      "inputs": [
        "source_signals",
        "requested_signal"
      ],
      "outputs": [
        "priority_result"
      ],
      "authority": "bounded_transformation",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "campaign",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "variant_factory",
      "worker": "variant_factory",
      "inputs": [
        "verified_copy",
        "source_state"
      ],
      "outputs": [
        "variant_factory_result"
      ],
      "authority": "bounded_transformation",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "format",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "format",
      "worker": "format_worker",
      "inputs": [
        "selected_format",
        "variant",
        "approved_asset"
      ],
      "outputs": [
        "format_result"
      ],
      "authority": "bounded_transformation",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "adapt",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "evidence_gate",
      "worker": "gate",
      "inputs": [
        "truth_hash",
        "source_state",
        "evidence",
        "asset_copy"
      ],
      "outputs": [
        "evidence_gate_result"
      ],
      "authority": "verify_only",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "brand_gate",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "brand_gate",
      "worker": "gate",
      "inputs": [
        "product.brand_review",
        "product.risk_review"
      ],
      "outputs": [
        "brand_gate_result"
      ],
      "authority": "verify_only",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "permission_gate",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "normalize",
      "worker": "outcome_normalizer",
      "inputs": [
        "native_measurements",
        "execution_state"
      ],
      "outputs": [
        "normalize_result"
      ],
      "authority": "bounded_transformation",
      "failure_state": "BLOCKED_OR_UNKNOWN",
      "handoff": [
        "learn"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic_approved_reuse"
    },
    {
      "id": "autonomous_scheduler",
      "worker": "GraphEngine.tick",
      "inputs": [
        "trusted_product_revisions",
        "receipt_index",
        "scheduler_seen"
      ],
      "outputs": [
        "next_cycle_input",
        "due_performance_receipt"
      ],
      "authority": "bounded scheduling; product autonomous flag required",
      "failure_state": "BLOCKED_NO_EXTERNAL_ACTION",
      "handoff": [
        "ingest",
        "observe"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic"
    },
    {
      "id": "relevance",
      "worker": "relevance_router",
      "inputs": [
        "source_signal",
        "verified_destinations",
        "learning.routes"
      ],
      "outputs": [
        "relevance_ranked_destinations"
      ],
      "authority": "bounded ranking only",
      "failure_state": "BLOCKED",
      "handoff": [
        "scout",
        "receipt"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic"
    },
    {
      "id": "product_context_intake",
      "worker": "ProductIntake.receive",
      "inputs": [
        "signed_source_envelope",
        "registered_source_key",
        "owner_policy",
        "prior_sequence"
      ],
      "outputs": [
        "source_receipt",
        "persistent_product_truth"
      ],
      "authority": "product truth only; cannot grant marketing permission, budget or brand changes",
      "failure_state": "BLOCKED_INVALID_SIGNATURE_OR_STALE_SOURCE",
      "handoff": [
        "ingest"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic"
    },
    {
      "id": "native_source_adapter",
      "worker": "emradarSource",
      "inputs": [
        "native_scan",
        "source_attestation"
      ],
      "outputs": [
        "source_signals_with_evidence_and_uncertainty"
      ],
      "authority": "schema translation; never grants release approval",
      "failure_state": "BLOCKED_INVALID_SCAN_OR_UNKNOWN_STATE",
      "handoff": [
        "product_context_intake"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic"
    },
    {
      "id": "emradar_finding",
      "label": "EMRADAR_FINDING",
      "worker": "emradar_finding",
      "inputs": [
        "verified_source",
        "discovery_context"
      ],
      "outputs": [
        "bounded_discovery_context"
      ],
      "authority": "Read-only discovery and dry reply preview only; no engagement, campaign, publication or learning mutation",
      "failure_state": "BLOCKED",
      "handoff": [
        "x_discovery"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic"
    },
    {
      "id": "x_discovery",
      "label": "X_DISCOVERY",
      "worker": "x_discovery",
      "inputs": [
        "verified_source",
        "discovery_context"
      ],
      "outputs": [
        "bounded_discovery_context"
      ],
      "authority": "Read-only discovery and dry reply preview only; no engagement, campaign, publication or learning mutation",
      "failure_state": "BLOCKED",
      "handoff": [
        "conversation_baseline"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic"
    },
    {
      "id": "conversation_baseline",
      "label": "CONVERSATION_BASELINE",
      "worker": "conversation_baseline",
      "inputs": [
        "verified_source",
        "discovery_context"
      ],
      "outputs": [
        "bounded_discovery_context"
      ],
      "authority": "Read-only discovery and dry reply preview only; no engagement, campaign, publication or learning mutation",
      "failure_state": "BLOCKED",
      "handoff": [
        "discovery_relevance_gate"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic"
    },
    {
      "id": "discovery_relevance_gate",
      "label": "RELEVANCE_GATE",
      "worker": "discovery_relevance_gate",
      "inputs": [
        "verified_source",
        "discovery_context"
      ],
      "outputs": [
        "bounded_discovery_context"
      ],
      "authority": "Read-only discovery and dry reply preview only; no engagement, campaign, publication or learning mutation",
      "failure_state": "BLOCKED",
      "handoff": [
        "information_delta_gate"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic"
    },
    {
      "id": "information_delta_gate",
      "label": "INFORMATION_DELTA_GATE",
      "worker": "information_delta_gate",
      "inputs": [
        "verified_source",
        "discovery_context"
      ],
      "outputs": [
        "bounded_discovery_context"
      ],
      "authority": "Read-only discovery and dry reply preview only; no engagement, campaign, publication or learning mutation",
      "failure_state": "BLOCKED",
      "handoff": [
        "reply_draft"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic"
    },
    {
      "id": "reply_draft",
      "label": "REPLY_DRAFT",
      "worker": "reply_draft",
      "inputs": [
        "verified_source",
        "discovery_context"
      ],
      "outputs": [
        "bounded_discovery_context"
      ],
      "authority": "Read-only discovery and dry reply preview only; no engagement, campaign, publication or learning mutation",
      "failure_state": "BLOCKED",
      "handoff": [
        "discovery_evidence_gate"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic"
    },
    {
      "id": "discovery_evidence_gate",
      "label": "EVIDENCE_GATE",
      "worker": "discovery_evidence_gate",
      "inputs": [
        "verified_source",
        "discovery_context"
      ],
      "outputs": [
        "bounded_discovery_context"
      ],
      "authority": "Read-only discovery and dry reply preview only; no engagement, campaign, publication or learning mutation",
      "failure_state": "BLOCKED",
      "handoff": [
        "human_preview"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic"
    },
    {
      "id": "human_preview",
      "label": "HUMAN_PREVIEW",
      "worker": "human_preview",
      "inputs": [
        "verified_source",
        "discovery_context"
      ],
      "outputs": [
        "bounded_discovery_context"
      ],
      "authority": "Read-only discovery and dry reply preview only; no engagement, campaign, publication or learning mutation",
      "failure_state": "BLOCKED",
      "handoff": [
        "discovery_stop"
      ],
      "max_attempts": 1,
      "execution_lane": "deterministic"
    },
    {
      "id": "discovery_stop",
      "label": "STOP",
      "worker": "discovery_stop",
      "inputs": [
        "verified_source",
        "discovery_context"
      ],
      "outputs": [
        "bounded_discovery_context"
      ],
      "authority": "Read-only discovery and dry reply preview only; no engagement, campaign, publication or learning mutation",
      "failure_state": "BLOCKED",
      "handoff": [],
      "max_attempts": 1,
      "execution_lane": "deterministic"
    }
  ],
  "invariants": {
    "signal_state_preservation": true,
    "meaningful_delta_required": true,
    "no_broad_search_for_completeness": true,
    "no_fabricated_performance": true,
    "unknown_is_valid_state": true,
    "receipt_required": true,
    "retire_not_delete": true,
    "editorial_quality_required": true,
    "no_style_imitation": true,
    "no_hindsight_contamination": true,
    "scan_research_reuse": true,
    "marketing_may_prepare_in_parallel": true,
    "distribution_requires_final_scan_gate": true,
    "external_publication_requires_exact_owner_review": true,
    "t_plus_tracking_never_blocks_marketing": true
  },
  "execution_routing": {
    "owner": "VC Harness",
    "repository": "oroknows-arch1/vcharness",
    "contract_version": "elastic-routing-v0.1",
    "contract_paths": [
      "src/routing/contracts.ts",
      "src/routing/router.ts",
      "src/routing/registry.ts"
    ],
    "boundary": "Marketing declares bounded work units and required quality/tools/risk. Harness selects deterministic/model/human lane, provider/model, concurrency, attempt ceiling and escalation.",
    "usage_policy": [
      "deterministic work must not consume model usage",
      "select lowest-cost permitted available provider adequate for the classified lane",
      "wide separable work requests wide-parallel rather than serial high-cost reasoning",
      "escalate only after bounded failure or verification need",
      "respect provider health, permissions, tools and data sensitivity",
      "record routing telemetry including tokens, estimated cost and work allowance when available"
    ],
    "wide_parallel": {
      "requested_by_marketing": true,
      "provider_selection": "Harness-owned",
      "note": "Marketing never assumes a provider. Harness owns live provider health and selection; Kimi K3 may be used when its runtime health gate passes."
    }
  },
  "work_unit_policy": {
    "scout": {
      "complexity": "low",
      "separable": true,
      "aiRequired": true
    },
    "destination_baseline": {
      "complexity": "low",
      "separable": true,
      "aiRequired": true
    },
    "emradar_delta": {
      "complexity": "medium",
      "separable": false,
      "aiRequired": true
    },
    "novelty_gate": {
      "complexity": "fixed",
      "separable": false,
      "aiRequired": false
    },
    "route": {
      "complexity": "medium",
      "separable": false,
      "aiRequired": true
    },
    "adapt": {
      "complexity": "medium",
      "separable": true,
      "aiRequired": true
    },
    "permission_gate": {
      "complexity": "fixed",
      "separable": false,
      "aiRequired": false
    },
    "publication_review": {
      "complexity": "fixed",
      "separable": false,
      "aiRequired": false
    },
    "receipt": {
      "complexity": "fixed",
      "separable": false,
      "aiRequired": false
    },
    "observe": {
      "complexity": "fixed",
      "separable": true,
      "aiRequired": false
    },
    "learn": {
      "complexity": "fixed",
      "separable": false,
